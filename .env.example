# Copy this file to an ignored local environment file only when a later command needs it.
# Keep values blank here. Never commit endpoints, tokens, keys, coordinates, or reviewer data.

# Copernicus Data Space Ecosystem OAuth client (server only).
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Optional Part 7 controls; leave blank to use safe defaults.
CDSE_COLLECTION_ID=
CDSE_VV_BAND=
CDSE_VH_BAND=
CDSE_TOKEN_SAFETY_MS=
CDSE_USAGE_CACHE_MS=
CDSE_FREE_CREDIT_REFERENCE=
CDSE_DISPATCH_ENABLED=

# Part 8 discovery is server-only and disabled until explicitly enabled.
PART8_DISCOVERY_ENABLED=
PART8_POLL_OVERLAP_MINUTES=
PART8_STAC_PAGE_SIZE=
PART8_MAX_PAGES=
PART8_MAX_ITEMS=
PART8_REQUEST_TIMEOUT_MS=
PART8_RETRY_ATTEMPTS=
PART8_INITIAL_RETRY_DELAY_MS=
PART8_MAX_RETRY_DELAY_MS=
PART8_PREPROCESSING_VERSION=
PART8_MODEL_VERSION=
# Store the matching value in Supabase Vault as part8_cron_secret.
PART8_CRON_SECRET=

# SUPABASE_URL and SUPABASE_ANON_KEY are the only browser-allowlisted values.
# RLS is still required before either value is used by a future dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only; bypasses RLS and must never enter a browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 configuration (server only).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Alert delivery (server only).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server-side GitHub dispatch credential.
GITHUB_DISPATCH_TOKEN=
